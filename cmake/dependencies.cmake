else()
  find_package(Jolt CONFIG REQUIRED)
  set(WE_JOLT_TARGET Jolt::Jolt)
  find_package(flatbuffers 25.2.10 EXACT CONFIG REQUIRED)
  set(WE_FLATC flatbuffers::flatc)
  get_target_property(WE_FLATBUFFERS_INCLUDE flatbuffers::flatbuffers INTERFACE_INCLUDE_DIRECTORIES)
  set(WE_FLATBUFFERS_PYTHON "" CACHE PATH "Pinned flatbuffers 25.2.10 Python runtime directory")
  if(NOT EXISTS "${WE_FLATBUFFERS_PYTHON}/_version.py")
