include(FetchContent)
# Hashes bind the development bootstrap to reviewed archives. Release dependency
# resolution uses the immutable vcpkg baseline instead (see ADR-001).
function(we_archive name filename url hash)
  if(EXISTS "${PROJECT_SOURCE_DIR}/.deps/${filename}")
    set(url "${PROJECT_SOURCE_DIR}/.deps/${filename}")
  endif()
  FetchContent_Declare(${name} SYSTEM URL "${url}" URL_HASH "SHA256=${hash}")
endfunction()
if(WE_SYSTEM_DEVELOPMENT_DEPS)
  we_archive(json json.tar.gz https://codeload.github.com/nlohmann/json/tar.gz/refs/tags/v3.12.0 4b92eb0c06d10683f7447ce9406cb97cd4b453be18d7279320f7b2f025c10187)
  set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
  FetchContent_MakeAvailable(json)
  we_archive(flatbuffers flatbuffers.tar.gz https://codeload.github.com/google/flatbuffers/tar.gz/refs/tags/v25.2.10 b9c2df49707c57a48fc0923d52b8c73beb72d675f9d44b2211e4569be40a7421)
  set(FLATBUFFERS_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(FLATBUFFERS_BUILD_FLATLIB OFF CACHE BOOL "" FORCE)
  set(FLATBUFFERS_INSTALL OFF CACHE BOOL "" FORCE)
  FetchContent_MakeAvailable(flatbuffers)
  set(WE_FLATC flatc)
  set(WE_FLATBUFFERS_INCLUDE "${flatbuffers_SOURCE_DIR}/include")
  set(WE_FLATBUFFERS_PYTHON "${flatbuffers_SOURCE_DIR}/python/flatbuffers")
  if(BUILD_TESTING)
    we_archive(catch2 catch2.tar.gz https://codeload.github.com/catchorg/Catch2/tar.gz/refs/tags/v3.8.1 18b3f70ac80fccc340d8c6ff0f339b2ae64944782f8d2fca2bd705cf47cadb79)
    FetchContent_MakeAvailable(catch2)
    list(APPEND CMAKE_MODULE_PATH "${catch2_SOURCE_DIR}/extras")
  endif()
else()
  find_package(flatbuffers 25.2.10 EXACT CONFIG REQUIRED)
  set(WE_FLATC flatbuffers::flatc)
  get_target_property(WE_FLATBUFFERS_INCLUDE flatbuffers::flatbuffers INTERFACE_INCLUDE_DIRECTORIES)
  set(WE_FLATBUFFERS_PYTHON "" CACHE PATH "Pinned flatbuffers 25.2.10 Python runtime directory")
  if(NOT EXISTS "${WE_FLATBUFFERS_PYTHON}/_version.py")
    message(FATAL_ERROR "Provide WE_FLATBUFFERS_PYTHON for the explicit worker runtime package")
  endif()
  find_package(nlohmann_json CONFIG REQUIRED)
  if(BUILD_TESTING)
    find_package(Catch2 3 CONFIG REQUIRED)
  endif()
endif()
