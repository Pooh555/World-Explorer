include(FetchContent)
# Hashes bind the development bootstrap to reviewed archives. Release dependency
# resolution uses the immutable vcpkg baseline instead (see ADR-001).
function(we_archive name filename url hash)
  if(EXISTS "${PROJECT_SOURCE_DIR}/.deps/${filename}")
    set(url "${PROJECT_SOURCE_DIR}/.deps/${filename}")
  endif()
  if(name STREQUAL "jolt53")
    # Jolt's CMake project lives below Build/ in the tagged source archive.
    set(source_subdir SOURCE_SUBDIR Build)
  endif()
  FetchContent_Declare(${name} SYSTEM URL "${url}" URL_HASH "SHA256=${hash}" ${source_subdir})
endfunction()
if(WE_SYSTEM_DEVELOPMENT_DEPS)
