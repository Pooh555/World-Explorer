namespace world_explorer.wire;

table handshake {
  backend:string (required);
  backend_version:string (required);
  sensors:[string] (required);
  batch:bool;
  streaming_tracking:bool;
  device_options:[string] (required);
  checkpoint_semantics:string (required);
  checkpoint_rights:string (required);
  max_message_bytes:uint;
  max_frames:uint;
  max_source_bytes:ulong;
  max_output_bytes:ulong;
}

table progress {
  stage:string (required);
  message:string (required);
  elapsed_seconds:double;
}

table artifact_reference {
  path:string (required);
  sha256:string (required);
  bytes:ulong;
}

table completed {
  stage:string (required);
  artifact:artifact_reference;
}

table failure {
  code:string (required);
  stage:string (required);
  message:string (required);
  recovery:string (required);
}

enum command_kind:ubyte { START, CANCEL }
table command_acknowledged {
  command_sequence:ulong;
  command_operation:ulong;
  kind:command_kind;
}
union payload { handshake, progress, completed, failure, command_acknowledged }
table envelope {
  api_major:ushort = 2;
  api_minor:ushort;
  sequence:ulong;
  body:payload;
  session:string (required);
  operation:ulong;
}
root_type envelope;
file_identifier "WEW2";
file_extension "wewire";
